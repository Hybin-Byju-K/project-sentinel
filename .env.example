# Project Sentinel - Backend Environment Variables
# Neon Database Connection String (Use the pooled connection string for application runtime)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-ENDPOINT-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Optional: Comma-separated list of additional frontend domains for CORS
ALLOWED_ORIGINS=https://project-sentinel.vercel.app

# Optional: Regex pattern for preview domains (defaults to https://.*\.vercel\.app)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
